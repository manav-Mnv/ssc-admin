# Copy this template to .env.local for local dev (vercel dev), or set via `vercel env add` for production.

# Supabase Configurations
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
ADMIN_KEY=your_reviewer_admin_passcode_here
SUPER_ADMIN_KEY=your_super_admin_passcode_here

# Nodemailer SMTP Configurations
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-here
SMTP_FROM="AATCe Parul University" <your-email@gmail.com>
